# 複製此檔為 .env 並填入你的 OpenAI API Key
OPENAI_API_KEY=
PORT=3000

# 後台管理密碼（正式管理員帳號、角色權限、登入限制與操作稽核批次：只在 admin_users 資料表
# 完全沒有任何帳號時使用一次，自動建立第一位 owner 帳號，並拿這裡的值當作他的初始密碼；
# 帳號建立後，日常登入一律只驗證資料庫內的密碼雜湊，不會再直接比對這個值。建議登入後盡快
# 在「帳號管理」頁面設定新密碼。仍然是必填——admin_users 是空表、且沒有這個值時，系統無法
# 自動建立任何管理員帳號，會導致完全無法登入後台）
ADMIN_TOKEN=

# 第一位管理員帳號的帳號名稱（選填，只在上面 ADMIN_TOKEN 那次「自動建立第一位 owner」時使用；
# 不分大小寫，未設定時預設 owner）
ADMIN_BOOTSTRAP_USERNAME=

# ── 統一通知系統：Email／LINE（舊版 LINE Notify 已停止服務，不再支援）─────────────
# Email 通知用的 SMTP 設定（五項全部填齊才算「已設定」，任一缺少都視為未設定，見
# notification-channels.js 的 isEmailConfigured()）。未設定不影響詢價／訂單等主要功能，
# Email 通知會標記為 config_missing、不會嘗試寄送，後台「通知設定」頁面會顯示「尚未設定」。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=

# LINE 通知改用 LINE Messaging API 的 push message（兩項都要填才算「已設定」）。取得方式：
# LINE Developers Console 建立 Messaging API 頻道 → Channel access token（長期）；
# LINE_NOTIFICATION_TARGET_ID 是要接收通知的使用者／群組／聊天室 ID。未設定不影響主要功能，
# 後台「通知設定」頁面會顯示「尚未設定」。
LINE_CHANNEL_ACCESS_TOKEN=
LINE_NOTIFICATION_TARGET_ID=

# AI 使用次數限制的 client_hash 專用密鑰（HMAC-SHA256），建議用 crypto 產生至少32 bytes的
# 隨機字串，例如：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 未設定時會暫時借用 ADMIN_TOKEN 當密鑰（可運作，但更換管理密碼會讓既有使用次數限制重置）
AI_RATE_LIMIT_SECRET=

# 反向代理信任跳數，只能是0～3的整數；0＝不信任任何代理（本機/localhost環境用這個），
# 部署到雲端反向代理（Railway／Render／Cloudflare等）後方時，依實際代理層數設定成1～3
TRUST_PROXY_HOPS=0

# 小竹AI客服的公開網址（Railway等外部服務部署位置）。首頁與配置器的客服浮動視窗
# 一律透過 /api/chatbot-config 讀取這裡的值，不在前端 HTML 寫死；未設定時客服
# 視窗會直接顯示「目前維護中」備援畫面，不會嘗試建立 iframe。
CHATBOT_PUBLIC_URL=

# ── 後台登入 Session（登入與憑證傳輸安全批次）───────────────────────────
# 後台登入後Session的存活時間（小時），超過這個時數需要重新輸入密碼；格式錯誤或空白時
# 自動退回預設值8小時。
ADMIN_SESSION_TTL_HOURS=8

# 後台登入 Cookie 是否要求 Secure（只能透過HTTPS傳送）。true／false／留空三選一：
# - 本機用 http://localhost 測試（包含 NODE_ENV=production 的本機測試模式）請設為 false，
#   否則瀏覽器會拒絕在HTTP連線下寫入標記Secure的Cookie，導致完全無法登入。
# - 正式環境使用HTTPS時請設為 true。
# - 留空則自動依這次請求是否為HTTPS判斷（會尊重 TRUST_PROXY_HOPS 對 X-Forwarded-Proto
#   的信任設定），部署到雲端反向代理（Railway／Render等）後方、且已經正確設定
#   TRUST_PROXY_HOPS 時，通常不需要手動設定這個變數。
ADMIN_COOKIE_SECURE=

# CSRF Token 專用密鑰（HMAC-SHA256），跟登入密碼 ADMIN_TOKEN 是兩把完全獨立的密鑰，不可
# 共用、也不可用其中一把推算出另一把。建議用 crypto 產生至少32 bytes的隨機字串，例如：
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 未設定時會暫時使用僅存在於這次伺服器執行期間的隨機密鑰（可運作，但伺服器重啟後所有既有
# 登入Session的CSRF Token會失效，需要重新登入），建議設定固定值避免這個狀況。
ADMIN_CSRF_SECRET=

# 允許讀取後台API回應的網站來源白名單（CORS），多個來源用逗號分隔，
# 例如：https://admin.example.com,https://backup.example.com
# 這台伺服器自己的網址（同源請求）一律允許，不需要、也不應該寫進這裡；只有需要從
# 「另一個網域」用瀏覽器JavaScript呼叫這台伺服器的後台API時才需要設定，本機開發、
# 只有單一網域使用後台的情況下可以留空（留空＝只允許同源請求）。
ADMIN_ALLOWED_ORIGINS=

# ── 正式部署環境準備 ─────────────────────────────────────────────────
# 執行環境：本機開發留空或 development；正式部署設定 production。會影響 Cookie Secure
# 判斷、訂單／工廠包／資料庫／商品上傳圖片資料夾位置、是否允許 FORM_TEST_MODE 等多處行為，
# 正式上線前務必確認部署平台有設定這個值。
NODE_ENV=development

# 永久資料根目錄（部署前總驗收：單一永久資料根目錄批次）。只有 NODE_ENV=production 時
# 才會讀取這個變數，development／test 完全不受影響。必須是絕對路徑，且不可以是磁碟根目錄
# 或專案原始碼根目錄，格式錯誤或未設定都會讓伺服器在碰到任何資料庫操作之前就直接拒絕啟動
# （不會、也不可能悄悄退回其他路徑）。設定後，以下五類正式資料全部集中存放在這一個目錄底下：
#   APP_DATA_DIR/admin.db            （SQLite主資料庫）
#   APP_DATA_DIR/backups/            （資料庫備份）
#   APP_DATA_DIR/orders/             （訂單JSON與客戶上傳的設計圖）
#   APP_DATA_DIR/factory-packages/   （工廠下載包）
#   APP_DATA_DIR/product-uploads/    （商品上傳圖片，既有 /assets/uploads/products/檔名
#                                      對外網址格式不變，只有實體檔案存放位置改變）
# 部署平台若提供「持久化磁碟／Volume」功能，這裡設定的路徑就是要掛載持久化磁碟的位置——
# 只需要掛載「這一個」路徑，不需要像修改前那樣分別掛載五個不同資料夾。
# 範例：APP_DATA_DIR=/data（Linux 容器平台常見掛載路徑）
# 第一次從本機（development 路徑）改用 APP_DATA_DIR 部署時，請先用
# scripts/prepare-deploy-data.js 把既有資料複製過去，詳見 DEPLOYMENT.md 第 0 節。
APP_DATA_DIR=

# Content-Security-Policy 是否切換為正式強制模式（true／留空兩選一）。留空＝維持
# Report-Only（只回報不封鎖，安全預設值）。全站目前仍大量依賴行內 onclick／inline
# style／少數行內 <script>，貿然設成 true 會讓部分按鈕失效，開啟前務必先完成一次完整
# 瀏覽器回歸測試（見 DEPLOYMENT.md）。production 環境也不會自動開啟，需要另外手動設定。
CSP_ENFORCE=

# 詢價表單測試模式（true／留空或 false 兩選一）。開啟後 /api/save-order 不會寫入真正的
# 訂單檔案、不會發送 LINE 通知，只回傳格式一致的模擬成功結果，方便在不影響正式業務資料
# 的情況下測試整個詢價表單流程。production 環境絕對不能設為 true——伺服器啟動時會主動
# 檢查並拒絕啟動，避免正式詢價單被誤當成測試資料丟棄。
FORM_TEST_MODE=
